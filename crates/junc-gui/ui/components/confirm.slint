// SPDX-License-Identifier: GPL-3.0-or-later
// Confirm dialog (Spec): a panel on surface.window with the popover
// border, padding 18; title in type.heading, an optional lead, the
// consequences listed on surface.card (under a small heading when given,
// with a subtle note after), buttons right-aligned. Focus starts on
// Cancel; the destructive button needs Ctrl+Enter; Esc cancels. The owner
// draws the 50 % surface.window scrim behind it.

import { Tokens } from "../tokens.slint";
import { JButton } from "button.slint";
import { JKbd } from "kbd.slint";

export component JConfirm inherits Rectangle {
    in property <string> title;
    // What it means for apps, above the list (board 22).
    in property <string> lead;
    // "Removed with it": the list's heading; without one, lines are dotted.
    in property <string> heading;
    in property <[string]> consequences;
    // What stays as it was, under the list.
    in property <string> note;
    in property <string> confirm-text;
    in property <string> confirm-icon;
    // The buttons' keys inside them (board 22).
    in property <bool> show-keys;
    callback confirmed();
    callback cancelled();

    width: (root.heading == "" ? 420px : 480px) * Tokens.scale;
    background: Tokens.surface-window;
    border-width: Tokens.border-popover;
    border-color: Tokens.accent;
    accessible-role: groupbox;
    accessible-label: root.title;

    public function open() { cancel.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancelled(); return accept; }
            if e.text == "\n" && e.modifiers.control { root.confirmed(); return accept; }
            reject
        }
        VerticalLayout {
            padding: Tokens.space-panel-pad;
            spacing: Tokens.space-panel-gap;
            Text {
                text: root.title;
                font-size: Tokens.type-heading;
                color: Tokens.text-strong;
                wrap: word-wrap;
            }
            if root.lead != "": Text {
                text: root.lead;
                color: Tokens.text-default;
                wrap: word-wrap;
            }
            Rectangle {
                background: Tokens.surface-card;
                border-width: root.heading == "" ? 0 : Tokens.border;
                border-color: Tokens.line-divider;
                VerticalLayout {
                    padding: root.heading == "" ? 10px : 14px * Tokens.scale;
                    spacing: Tokens.space-label-gap;
                    if root.heading != "": Text {
                        text: root.heading;
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-caption;
                    }
                    for c in root.consequences: Text {
                        text: (root.heading == "" ? "· " : "") + c;
                        color: Tokens.text-default;
                        wrap: word-wrap;
                    }
                    if root.note != "": Text {
                        text: root.note;
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-caption;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-row-gap;
                cancel := JButton {
                    text: @tr("Cancel");
                    shortcut: "Esc";
                    show-key: root.show-keys;
                    clicked => { root.cancelled(); }
                }
                JButton {
                    text: root.confirm-text;
                    icon: root.confirm-icon;
                    destructive: true;
                    needs-ctrl: true;
                    shortcut: "Ctrl+Enter";
                    show-key: root.show-keys;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
