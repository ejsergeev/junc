// SPDX-License-Identifier: GPL-3.0-or-later
// Picker (Spec): a popover on surface.window with an accent popover border,
// padding 14, width 320; a search field in the focus state; group captions
// in type.caption; 28px rows. The cursor row has the hover fill and border
// and accent text; added items are disabled with "added". ↑ ↓ move, Enter
// adds, Esc closes. The owner filters the rows as the search text changes.
// A11y fixes from the validation: the root is exposed as a labelled group
// (Slint has no dialog role; the best available), the search field is
// labelled, focus stays inside until it closes. With `hints` a footer
// under a divider names the keys (board 7); a `note` under the rows says
// what to do when the one sought is missing (board 17).

import { Tokens } from "../tokens.slint";
import { ControlState } from "state.slint";

export struct PickerItem {
    // Caption shown above this item when it starts a group.
    group: string,
    text: string,
    detail: string,
    added: bool,
    // A Nerd Font glyph before the text; "" for none.
    icon: string,
}

export component JPicker inherits Rectangle {
    in property <string> title;
    in property <string> placeholder;
    in property <[PickerItem]> items;
    // A Nerd Font glyph in the search field; "" for none.
    in property <string> search-icon;
    // The footer naming ↑↓, Enter and Esc.
    in property <bool> hints;
    in property <string> note;
    in property <string> pick-word: @tr("add");
    // A long list (the languages) scrolls past this height, keeping the
    // cursor's row in view; 0 shows every row.
    in property <length> max-list-height: 0;
    in-out property <string> search;
    in-out property <int> cursor: 0;
    callback picked(int);
    callback closed();
    callback search-edited(string);

    width: 320px * Tokens.scale;
    background: Tokens.surface-window;
    border-width: Tokens.border-popover;
    border-color: Tokens.accent;
    accessible-role: groupbox;
    accessible-label: root.title;

    public function open() { field.focus(); }
    function step(d: int) {
        root.cursor = clamp(root.cursor + d, 0, max(0, root.items.length - 1));
    }
    function choose() {
        if root.cursor < root.items.length && !root.items[root.cursor].added {
            root.picked(root.cursor);
        }
    }

    VerticalLayout {
        padding: Tokens.space-popup-pad;
        spacing: Tokens.space-row-gap;
        Rectangle {
            height: Tokens.size-control;
            background: Tokens.control-focus-fill;
            border-width: Tokens.border;
            border-color: Tokens.control-focus-border;
            if root.search-icon != "": Text {
                x: Tokens.space-control-pad-x;
                width: 16px * Tokens.scale;
                height: parent.height;
                vertical-alignment: center;
                text: root.search-icon;
                color: Tokens.text-subtle;
                accessible-role: none;
            }
            property <length> text-x: Tokens.space-control-pad-x + (root.search-icon != "" ? 22px * Tokens.scale : 0);
            field := TextInput {
                x: parent.text-x;
                width: parent.width - parent.text-x - Tokens.space-control-pad-x;
                height: parent.height;
                vertical-alignment: center;
                text <=> root.search;
                color: Tokens.text-strong;
                selection-background-color: Tokens.text-selection-fill;
                font-size: Tokens.type-body;
                single-line: true;
                accessible-role: text-input;
                accessible-label: root.placeholder;
                accessible-placeholder-text: root.placeholder;
                edited => {
                    root.cursor = 0;
                    list.viewport-y = 0;
                    root.search-edited(self.text);
                }
                key-pressed(e) => {
                    if e.text == Key.DownArrow { root.step(1); return accept; }
                    if e.text == Key.UpArrow { root.step(-1); return accept; }
                    if e.text == "\n" { root.choose(); return accept; }
                    if e.text == Key.Escape { root.closed(); return accept; }
                    // Focus trap: Tab stays in the picker.
                    if e.text == Key.Tab || e.text == Key.Backtab { return accept; }
                    reject
                }
            }
            if root.search == "": Text {
                x: parent.text-x;
                width: parent.width - parent.text-x - Tokens.space-control-pad-x;
                horizontal-alignment: left;
                overflow: elide;
                height: parent.height;
                vertical-alignment: center;
                text: root.placeholder;
                color: Tokens.text-subtle;
                accessible-role: none;
            }
        }
        // Rows touch (28 px apart); a group's caption sits above its first.
        list := Flickable {
            height: root.max-list-height > 0 ? min(rows.preferred-height, root.max-list-height) : rows.preferred-height;
            viewport-height: rows.preferred-height;
            interactive: root.max-list-height > 0;
        rows := VerticalLayout {
        width: list.width;
        for item[i] in root.items: VerticalLayout {
            // Keep the cursor's row in view.
            property <bool> current: i == root.cursor;
            changed current => {
                if self.current && root.max-list-height > 0 {
                    if self.y + list.viewport-y < 0 {
                        list.viewport-y = -self.y;
                    } else if self.y + self.height + list.viewport-y > list.height {
                        list.viewport-y = list.height - self.y - self.height;
                    }
                }
            }
            if item.group != "": Text {
                text: item.group;
                font-size: Tokens.type-caption;
                color: Tokens.text-subtle;
                height: (i == 0 ? 18px : 30px) * Tokens.scale;
                vertical-alignment: center;
            }
            Rectangle {
                height: Tokens.size-control;
                property <bool> on: i == root.cursor;
                background: self.on ? Tokens.control-hover-fill : transparent;
                border-width: self.on ? Tokens.border : 0;
                border-color: Tokens.control-hover-border;
                accessible-role: list-item;
                accessible-label: item.text;
                accessible-description: item.added ? @tr("added") : item.detail;
                accessible-enabled: !item.added;
                accessible-item-selectable: true;
                accessible-item-selected: self.on;
                accessible-item-index: i;
                accessible-item-count: root.items.length;
                accessible-action-default => { root.cursor = i; root.choose(); }
                TouchArea {
                    clicked => { root.cursor = i; root.choose(); }
                    moved => { root.cursor = i; }
                }
                HorizontalLayout {
                    padding-left: Tokens.space-row-pad-x;
                    padding-right: Tokens.space-row-pad-x;
                    spacing: Tokens.space-row-gap;
                    if item.icon != "": Text {
                        text: item.icon;
                        vertical-alignment: center;
                        color: item.added ? Tokens.text-subtle : i == root.cursor ? Tokens.accent : Tokens.text-default;
                        accessible-role: none;
                    }
                    Text {
                        text: item.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: item.added ? Tokens.text-subtle : i == root.cursor ? Tokens.accent : Tokens.text-default;
                        accessible-role: none;
                    }
                    Text {
                        text: item.added ? @tr("added") : item.detail;
                        vertical-alignment: center;
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-body-small;
                        accessible-role: none;
                    }
                }
            }
        }
        }
        }
        if root.note != "": Text {
            text: root.note;
            color: Tokens.text-subtle;
            font-size: Tokens.type-body-small;
            wrap: word-wrap;
        }
        if root.hints: VerticalLayout {
            spacing: Tokens.space-row-gap;
            Rectangle {
                height: Tokens.border;
                background: Tokens.line-divider;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for hint in [
                    { key: "↑↓", text: @tr("move") },
                    { key: "Enter", text: root.pick-word },
                    { key: "Esc", text: @tr("close") },
                ]: HorizontalLayout {
                    spacing: 4px;
                    padding-right: 6px;
                    Text {
                        text: hint.key;
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-body-small;
                        vertical-alignment: center;
                    }
                    Text {
                        text: hint.text;
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-body-small;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
