// SPDX-License-Identifier: GPL-3.0-or-later
// The window (design boards 1–6): the sidebar with the Junctions and the
// Main screen of the selected one. Sizes follow docs/architecture.md §7.1:
// sidebar 300 px (240 px when the tile is narrower than 1100 px).

import { Tokens } from "tokens.slint";
import { JMenu } from "components/menu.slint";
import { View, Words, JunctionItem, CheckItem } from "view.slint";
import { OnboardingCheck, OnboardingTemplates } from "screens/onboarding.slint";
import { EmptyNone } from "screens/empty.slint";
import { PickerItem } from "components/picker.slint";
import { MainScreen, CardItem, PortItem, LinkItem, ChannelItem } from "screens/main.slint";
import { CableScreen } from "screens/cable.slint";
import { JMeter } from "components/meter.slint";
import { JSwitch } from "components/switch.slint";
import { JSlider } from "components/slider.slint";
import { JButton, JIconButton } from "components/button.slint";
export { Tokens, View, Words, JunctionItem, CheckItem, PickerItem, CardItem, PortItem, LinkItem, ChannelItem }
export { GalleryWindow } from "gallery.slint";

// One Junction in the sidebar: name and switch; what feeds it; its meter
// (4 px, bar only); its master volume.
component SidebarRow inherits Rectangle {
    in property <JunctionItem> item;
    in property <[float]> levels;
    callback select();
    callback toggled(bool);
    callback volume(int);
    // Right-click (board 21).
    callback menu();
    height: 102px * Tokens.scale;
    background: root.item.selected ? Tokens.selection : touch.has-hover ? Tokens.control-hover-fill : transparent;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { root.select(); }
    touch := TouchArea {
        clicked => { root.select(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.menu();
            }
        }
    }
    if root.item.selected: Rectangle {
        x: 0;
        width: 3px;
        background: Tokens.accent;
    }
    VerticalLayout {
        padding-left: Tokens.space-panel-pad;
        padding-right: Tokens.space-panel-pad;
        padding-top: 10px * Tokens.scale;
        padding-bottom: 8px * Tokens.scale;
        spacing: 4px * Tokens.scale;
        HorizontalLayout {
            spacing: Tokens.space-row-gap;
            Text {
                text: root.item.name;
                font-size: Tokens.type-title;
                color: root.item.enabled ? Tokens.text-strong : Tokens.text-subtle;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            JSwitch {
                label: root.item.name;
                checked: root.item.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            if root.item.cable || root.item.icons != "": Text {
                text: root.item.cable ? "\u{f0054}" : root.item.icons;
                color: Tokens.text-subtle;
                font-size: Tokens.type-body-small;
                accessible-role: none;
            }
            Text {
                text: !root.item.enabled ? @tr("Off · apps see silence")
                    : root.item.draft ? @tr("Cable") + " · " + @tr("not set up")
                    : root.item.cable ? @tr("Cable")
                    : root.item.inputs != "" ? root.item.inputs : @tr("No inputs yet");
                color: Tokens.text-subtle;
                font-size: Tokens.type-body-small;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.item.offline > 0: Text {
                text: "· " + @tr("{0} offline", root.item.offline);
                color: Tokens.status-urgent;
                font-size: Tokens.type-body-small;
            }
            if root.item.waiting > 0: Text {
                text: "· " + @tr("{0} waiting", root.item.waiting);
                color: Tokens.text-subtle;
                font-size: Tokens.type-body-small;
            }
        }
        JMeter {
            height: 4px;
            level: root.item.meter >= 0 && root.item.enabled ? root.levels[root.item.meter] : -60;
        }
        HorizontalLayout {
            spacing: Tokens.space-row-gap;
            Text {
                text: "\u{f057e}";
                color: Tokens.text-subtle;
                vertical-alignment: center;
                accessible-role: none;
            }
            JSlider {
                horizontal-stretch: 1;
                label: @tr("{0} volume", root.item.name);
                maximum: 150;
                value: root.item.volume;
                changed(v) => { root.volume(v); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "JUNC";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 420px;
    background: Tokens.surface-desktop;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.type-body;

    // Meters run (~7 Hz, Spec) only while the window is seen and something
    // is metered; stopped, the timer wakes nobody (architecture §7.6).
    in property <bool> meters-running;
    callback meter-tick();
    Timer {
        interval: 143ms;
        running: root.meters-running;
        triggered => { root.meter-tick(); }
    }

    out property <length> sidebar-width: root.width < 1100px ? 240px : 300px;

    // The New menu over the sidebar's New button.
    property <bool> new-menu;
    // How far the sidebar's rows are scrolled.
    property <length> sidebar-y;
    // Board 21: the context menu of sidebar row `i`.
    function open-menu(i: int) {
        View.menu-cursor = 0;
        View.menu-index = i;
    }


    forward-focus: shortcuts;
    // Window-wide shortcuts (architecture §7.4): keys nothing focused took.
    shortcuts := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        key-pressed(e) => {
            if View.onboarding != 0 { return reject; }
            // Input Options keep Esc and Del when an update moved the focus.
            if View.options-open && e.text == Key.Escape {
                View.options-closed();
                return accept;
            }
            if View.options-open && e.text == Key.Delete && !e.modifiers.control {
                View.options-remove();
                return accept;
            }
            // Board 18: Space turns the selected Junction back on.
            if e.text == " " && View.selected != "" && !View.junction-on && !e.modifiers.control {
                View.junction-toggled(View.selected, true);
                return accept;
            }
            // Del with the pointer on a link unlinks it (§7.4).
            if e.text == Key.Delete && View.tip-visible && View.linking == 0 && !e.modifiers.control {
                View.link-clicked();
                return accept;
            }
            // Board 21: the Menu key or Shift+F10 opens the selected row's menu.
            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) && View.selected != "" {
                root.open-menu(View.selected-row);
                return accept;
            }
            // Board 26: F2 renames the selected Junction or Cable.
            if e.text == Key.F2 && View.selected != "" {
                View.renaming = true;
                return accept;
            }
            if !e.modifiers.control { return reject; }
            // Board 22: Ctrl+Delete asks before deleting the selected one.
            if e.text == Key.Delete && View.selected != "" {
                View.confirming = true;
                return accept;
            }
            // Ctrl+1…9: the Junctions in the sidebar's order.
            if !e.modifiers.shift && e.text >= "1" && e.text <= "9" && e.text.character-count == 1 {
                let n = e.text.to-float();
                if n <= View.junctions.length {
                    View.select(View.junctions[n - 1].id);
                }
                return accept;
            }
            if !e.modifiers.shift && (e.text == "n" || e.text == "N") && View.selected != "" {
                View.open-picker();
                return accept;
            }
            if !e.modifiers.shift && (e.text == "m" || e.text == "M") && View.selected != "" {
                View.open-listen-picker();
                return accept;
            }
            if e.modifiers.shift && (e.text == "n" || e.text == "N") && View.selected != "" {
                View.adding-bus = true;
                return accept;
            }
            if !e.modifiers.shift && (e.text == "d" || e.text == "D") && View.selected != "" {
                View.duplicate(View.selected);
                return accept;
            }
            if e.modifiers.shift && (e.text == "k" || e.text == "K") {
                View.new-cable();
                return accept;
            }
            if e.modifiers.shift && (e.text == "j" || e.text == "J") {
                View.new-junction();
                return accept;
            }
            reject
        }

    // Placed explicitly so the window's size never comes from its content.
    if View.onboarding == 1: OnboardingCheck {
        width: root.width;
        height: root.height;
        checks: View.checks;
        checking: View.checking;
        passed: View.checks-passed;
        init => { self.focus(); }
        recheck => { View.recheck(); }
        continue => { View.onboarding-continue(); }
        copy(t) => { View.copy(t); }
    }
    if View.onboarding == 2: OnboardingTemplates {
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        back => { View.onboarding-back(); }
        chosen(id) => { View.template-chosen(id); }
    }
    if View.onboarding == 0: HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Rectangle {
            width: root.sidebar-width;
            background: Tokens.surface-sidebar;
            VerticalLayout {
                // Heading: Junctions and their count, Settings.
                Rectangle {
                    height: 62px * Tokens.scale;
                    HorizontalLayout {
                        padding-left: Tokens.space-panel-pad;
                        padding-right: Tokens.space-panel-pad;
                        padding-top: 16px * Tokens.scale;
                        spacing: 6px;
                        Text {
                            text: @tr("Junctions");
                            color: Tokens.text-strong;
                            font-size: Tokens.type-heading;
                            vertical-alignment: center;
                        }
                        Text {
                            text: View.junctions.length;
                            color: Tokens.text-subtle;
                            font-size: Tokens.type-caption;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        JIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "\u{f08bb}";
                            tooltip: @tr("Settings");
                            shortcut: "Ctrl+,";
                        }
                    }
                }
                Flickable {
                    changed content-y => { root.sidebar-y = self.content-y; }
                    VerticalLayout {
                        width: root.sidebar-width;
                        alignment: start;
                        for j[i] in View.junctions: SidebarRow {
                            item: j;
                            levels: View.levels;
                            select => { View.select(j.id); }
                            toggled(v) => { View.junction-toggled(j.id, v); }
                            volume(v) => { View.junction-volume(j.id, v); }
                            menu => { root.open-menu(i); }
                        }
                        if View.junctions.length == 0: HorizontalLayout {
                            padding-left: Tokens.space-panel-pad;
                            padding-right: Tokens.space-panel-pad;
                            Text {
                                width: root.sidebar-width - 2 * Tokens.space-panel-pad;
                                text: View.daemon-state == "down" ? @tr("juncd is not running") : @tr("No Junctions or Cables yet.");
                                font-size: Tokens.type-body-small;
                                color: Tokens.text-subtle;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                // New Junction or Cable.
                Rectangle {
                    height: 45px * Tokens.scale;
                    Rectangle {
                        y: 0;
                        height: Tokens.border;
                        background: Tokens.line-divider;
                    }
                    HorizontalLayout {
                        padding-left: Tokens.space-panel-pad;
                        alignment: start;
                        JButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("New");
                            icon: "\u{f0415}";
                            clicked => { root.new-menu = true; }
                        }
                    }
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Tokens.line-divider;
        }
        if View.selected != "" && View.cable: CableScreen {
            title: View.title;
            draft: View.cable-draft;
            node: View.node;
            bus-channels: View.bus-channels;
            from: View.cable-from;
            from-running: View.cable-from-running;
            to: View.cable-to;
            to-running: View.cable-to-running;
            volume: View.cable-volume;
            exclusive: View.cable-exclusive;
            listen: View.cable-listen;
            listen-index: View.cable-listen-index;
            outputs: View.cable-outputs;
            cards: View.cards;
            levels: View.levels;
            peaks: View.peaks;
            picker-open: View.picker-open;
            picker-cable: View.picker-cable;
            picker-items: View.picker-items;
            picker-search <=> View.picker-search;
            picker-cursor <=> View.picker-cursor;
            // Its cards and meters come from the Main model's layout.
            init => { View.relayout(800px); }
            volume-changed(v) => { View.junction-volume(View.selected, v); }
            exclusive-changed(v) => { View.cable-exclusive-changed(v); }
            listen-toggled(v, i) => { View.cable-listen-toggled(v, i); }
            listen-target(i) => { View.cable-listen-target(i); }
            change-app(to) => { View.open-cable-picker(to); }
            delete-junction => { View.delete-junction(); }
            renaming <=> View.renaming;
            confirming <=> View.confirming;
            confirm-closed => { shortcuts.focus(); }
            rename(t) => { View.rename(t); shortcuts.focus(); }
            picker-search-edited(t) => { View.picker-search-edited(t); }
            picker-picked(i) => { View.picker-picked(i); }
            picker-closed => { View.picker-closed(); shortcuts.focus(); }
        }
        if View.selected != "" && !View.cable: MainScreen {
            title: View.title;
            node: View.node;
            bus-channels: View.bus-channels;
            cable: View.cable;
            on: View.junction-on;
            turn-on => { View.junction-toggled(View.selected, true); }
            apps: View.apps;
            devices: View.devices;
            off: View.off;
            offline: View.offline;
            waiting: View.waiting;
            listen-count: View.listen-count;
            stacked: View.stacked;
            cards: View.cards;
            ports: View.ports;
            links: View.links;
            canvas-height: View.canvas-height;
            col-x0: View.col-x0;
            col-x1: View.col-x1;
            col-x2: View.col-x2;
            col-w: View.col-w;
            listen-heading-y: View.listen-heading-y;
            levels: View.levels;
            peaks: View.peaks;
            tip-visible: View.tip-visible;
            tip-x: View.tip-x;
            tip-y: View.tip-y;
            tip-owner: View.tip-owner;
            tip-ch: View.tip-ch;
            tip-pos: View.tip-pos;
            tip-bus: View.tip-bus;
            tip-listen: View.tip-listen;
            show-listen <=> View.show-listen;
            narrow: root.width < 1100px;
            changed canvas-width => { View.relayout(self.canvas-width); }
            changed show-listen => { View.relayout(self.canvas-width); }
            init => { View.relayout(self.canvas-width); }
            card-toggled(c, i, v) => { View.card-toggled(c, i, v); }
            card-volume(c, i, v) => { View.card-volume(c, i, v); }
            pointer-moved(x, y) => { View.pointer-moved(x, y); }
            pointer-left => { View.pointer-left(); }
            link-clicked => { View.link-clicked(); }
            port-remove(c, i, ch, side) => { View.port-remove(c, i, ch, side); }
            linking: View.linking;
            pending: View.pending;
            link-start(c, i, ch, side) => { View.link-start(c, i, ch, side); }
            link-key(c, i, ch, side) => { View.link-key(c, i, ch, side); }
            link-drag(x, y) => { View.link-drag(x, y); }
            link-drop => { View.link-drop(); }
            link-step(d) => { View.link-step(d); }
            link-cancel => { View.link-cancel(); }
            focus-card: View.focus-card;
            card-arrow(i, dx, dy) => { View.card-arrow(i, dx, dy); }
            focus-card-done => { View.focus-card = -1; }
            delete-junction => { View.delete-junction(); }
            renaming <=> View.renaming;
            confirming <=> View.confirming;
            confirm-closed => { shortcuts.focus(); }
            delete-lines: View.delete-lines;
            delete-note: View.delete-note;
            rename(t) => { View.rename(t); shortcuts.focus(); }
            empty-inputs: View.empty-inputs;
            empty-listens: View.empty-listens;
            empty-listens-y: View.empty-listens-y;
            empty-h: View.empty-h;
            picker-open: View.picker-open;
            picker-items: View.picker-items;
            picker-search <=> View.picker-search;
            picker-cursor <=> View.picker-cursor;
            open-picker => { View.open-picker(); }
            open-listen-picker => { View.open-listen-picker(); }
            picker-listen: View.picker-listen;
            adding-bus <=> View.adding-bus;
            options-open: View.options-open;
            options-index: View.options-index;
            options-x: View.options-x;
            options-y: View.options-y;
            options-w: View.options-w;
            options-h: View.options-h;
            options-title: View.options-title;
            options-app: View.options-app;
            options-exclusive: View.options-exclusive;
            options-channels: View.options-channels;
            options-feeds: View.options-feeds;
            bus-options: View.bus-options;
            options-toggled(i) => { View.options-toggled(i); }
            options-closed => { View.options-closed(); shortcuts.focus(); }
            options-exclusive-changed(v) => { View.options-exclusive-changed(v); }
            options-feed(ch, bus) => { View.options-feed(ch, bus); }
            options-remove => { View.options-remove(); shortcuts.focus(); }
            add-bus(n) => { View.add-bus(n); shortcuts.focus(); }
            add-bus-closed => { shortcuts.focus(); }
            picker-search-edited(t) => { View.picker-search-edited(t); }
            picker-picked(i) => { View.picker-picked(i); }
            picker-closed => { View.picker-closed(); shortcuts.focus(); }
        }
        if View.selected == "" && View.daemon-state != "down": EmptyNone {
            new-junction => { View.new-junction(); }
        }
        if View.selected == "" && View.daemon-state == "down": Rectangle {
            background: Tokens.surface-window;
        }
    }
    }

    // Board 21: beside its row, Esc or a click outside closes it.
    if View.menu-index >= 0 && View.menu-index < View.junctions.length: Rectangle {
        property <JunctionItem> item: View.junctions[View.menu-index];
        TouchArea { clicked => { View.menu-index = -1; shortcuts.focus(); } }
        JMenu {
            x: root.sidebar-width - 137px * Tokens.scale;
            y: min(62px * Tokens.scale + root.sidebar-y + View.menu-index * 102px * Tokens.scale + 32px * Tokens.scale,
                root.height - self.preferred-height - 8px);
            height: self.preferred-height;
            width: 240px * Tokens.scale;
            title: parent.item.name;
            cursor <=> View.menu-cursor;
            items: [
                { text: @tr("Rename"), shortcut: "F2", enabled: true },
                { text: @tr("Duplicate"), shortcut: "Ctrl+D", enabled: true },
                { text: parent.item.enabled ? @tr("Turn off") : @tr("Turn on"), shortcut: "Space", enabled: true },
                { text: @tr("Export preset…"), shortcut: "Ctrl+E", enabled: false, separator: true },
                { text: @tr("Import preset…"), shortcut: "Ctrl+I", enabled: false },
                { text: @tr("Delete…"), shortcut: "Ctrl+Delete", enabled: true, separator: true, destructive: true },
            ];
            init => { self.open(); }
            activated(i) => {
                let row = parent.item;
                View.menu-index = -1;
                shortcuts.focus();
                if i == 0 { View.select(row.id); View.renaming = true; }
                if i == 1 { View.duplicate(row.id); }
                if i == 2 { View.junction-toggled(row.id, !row.enabled); }
                if i == 5 { View.select(row.id); View.confirming = true; }
            }
            closed => { View.menu-index = -1; shortcuts.focus(); }
        }
    }

    // New: a Junction or a Cable (templates and presets come with B22).
    if root.new-menu: Rectangle {
        TouchArea { clicked => { root.new-menu = false; shortcuts.focus(); } }
        JMenu {
            x: Tokens.space-panel-pad;
            y: root.height - 45px * Tokens.scale - self.preferred-height;
            height: self.preferred-height;
            title: @tr("New");
            items: [
                { text: @tr("Junction"), detail: @tr("A virtual mic and speaker"), shortcut: "Ctrl+Shift+J", enabled: true },
                { text: @tr("Cable"), detail: @tr("One app straight into another"), shortcut: "Ctrl+Shift+K", enabled: true },
            ];
            init => { self.open(); }
            activated(i) => {
                root.new-menu = false;
                shortcuts.focus();
                if i == 0 { View.new-junction(); }
                if i == 1 { View.new-cable(); }
            }
            closed => { root.new-menu = false; shortcuts.focus(); }
        }
    }
}
