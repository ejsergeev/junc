// SPDX-License-Identifier: GPL-3.0-or-later
// Component gallery (B13): every component of ui/components in its states,
// laid out like section 2 of the Spec board, for screenshots and the AT-SPI
// dump. `junc-gui --scenario gallery` opens it.

import { Tokens } from "tokens.slint";
import { JButton, JIconButton } from "components/button.slint";
import { JSwitch } from "components/switch.slint";
import { JSlider } from "components/slider.slint";
import { JKbd } from "components/kbd.slint";
import { JBadge } from "components/badge.slint";
import { JTooltip } from "components/tooltip.slint";
import { JCard } from "components/card.slint";
import { JPort } from "components/port.slint";
import { JLink } from "components/link.slint";
import { JMeter } from "components/meter.slint";
import { JChannelGroup } from "components/channel-group.slint";
import { JPicker } from "components/picker.slint";
import { JMenu } from "components/menu.slint";
import { JRadioGroup } from "components/radio-group.slint";
import { JInlineField } from "components/inline-field.slint";
import { JConfirm } from "components/confirm.slint";
import { JEmptyState } from "components/empty-state.slint";
import { JCheckRow } from "components/check-row.slint";
import { JBanner } from "components/banner.slint";
import { JToast } from "components/toast.slint";
import { JLanguageRow } from "components/language-row.slint";

component Row inherits HorizontalLayout {
    in property <string> name;
    spacing: Tokens.space-panel-gap;
    alignment: start;
    Text {
        text: root.name;
        width: 140px;
        color: Tokens.text-strong;
        vertical-alignment: center;
        accessible-role: none;
    }
    @children
}

export component GalleryWindow inherits Window {
    title: "JUNC components";
    preferred-height: 900px;
    background: Tokens.surface-window;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.type-body;
    // What the last callback was, for tests.
    out property <string> last-event;

    preferred-width: 1300px;
    HorizontalLayout {
    padding: Tokens.space-panel-pad;
    spacing: 2 * Tokens.space-panel-gap;
    VerticalLayout {
        spacing: Tokens.space-panel-gap;
        alignment: start;
        Row {
            name: "Button";
            JButton { text: "Delete"; destructive: true; }
            JButton { text: "Show Listen"; checkable: true; checked: true; }
            JButton { text: "Add input"; icon: "\u{f0415}"; shortcut: "Ctrl+N"; primary: true; }
            JButton { text: "Disabled"; enabled: false; }
            JIconButton { icon: "\u{f0415}"; tooltip: "Add input"; shortcut: "Ctrl+N"; }
        }
        Row {
            name: "Toggle";
            JSwitch { label: "Zoom Mic"; checked: true; }
            JSwitch { label: "OBS Mix"; checked: false; }
            JSwitch { label: "Disabled"; enabled: false; }
        }
        Row {
            name: "Slider";
            JSlider { label: "Zoom Mic volume"; value: 50; width: 220px; }
            JSlider { label: "Boost"; value: 120; maximum: 150; width: 220px; }
        }
        Row {
            name: "Badge";
            JBadge { text: "Default input"; kind: "state"; }
            JBadge { text: "Pro Audio"; kind: "fact"; }
            JBadge { text: "device-specific"; kind: "caution"; }
        }
        Row {
            name: "Keyboard chip";
            JKbd { text: "Ctrl+N"; }
            JKbd { text: "Esc"; }
        }
        Row {
            name: "Card";
            JCard {
                width: 230px;
                title: "Spotify";
                glyph: "\u{f075a}";
                exclusive: true;
                volume: 70;
                Text { text: "Ch 1   L"; color: Tokens.text-default; }
                Text { text: "Ch 2   R"; color: Tokens.text-default; }
            }
            JCard {
                width: 230px;
                title: "USB Microphone";
                glyph: "\u{f036c}";
                state: "offline";
                Text { text: "Ch 1"; color: Tokens.text-default; }
            }
            JCard {
                width: 230px;
                title: "Firefox";
                glyph: "\u{f075a}";
                state: "not-running";
                app: "Firefox";
                Text { text: "Ch 1   L"; color: Tokens.text-default; }
            }
            JCard {
                width: 230px;
                title: "Soundux";
                on: false;
                Text { text: "Ch 1   L"; color: Tokens.text-default; }
            }
        }
        Row {
            name: "Port";
            JPort { label: "Ch 1 free"; state: "free"; }
            JPort { label: "Ch 2 linked"; state: "linked"; }
            JPort { label: "Ch 3 offline"; state: "offline"; }
            JPort { label: "Ch 4 valid"; state: "valid"; }
            JPort { label: "Ch 5 snap"; state: "snap"; }
        }
        Row {
            name: "Link";
            Rectangle {
                width: 160px;
                height: 48px;
                JLink { width: parent.width; height: parent.height; x1: 4px; y1: 8px; x2: 156px; y2: 40px; }
            }
            Rectangle {
                width: 160px;
                height: 48px;
                JLink { width: parent.width; height: parent.height; x1: 4px; y1: 8px; x2: 156px; y2: 40px; hovered: true; }
            }
            Rectangle {
                width: 160px;
                height: 48px;
                JLink { width: parent.width; height: parent.height; x1: 4px; y1: 8px; x2: 156px; y2: 40px; offline: true; }
            }
        }
        Row {
            name: "Meter";
            JMeter { width: 200px; level: -20; peak: -14; }
            JMeter { width: 200px; level: -8; peak: -5; }
            JMeter { width: 200px; level: -1; peak: -0.5; }
        }
        Row {
            name: "Channel group";
            JChannelGroup {
                width: 300px;
                label: "In 9–16";
                channels: [
                    { label: "In 9", level: -18, linked: false }, { label: "In 10", level: -24, linked: false },
                    { label: "In 11", level: -60, linked: false }, { label: "In 12", level: -30, linked: false },
                    { label: "In 13", level: -12, linked: false }, { label: "In 14", level: -40, linked: false },
                    { label: "In 15", level: -60, linked: false }, { label: "In 16", level: -50, linked: false },
                ];
            }
            JChannelGroup {
                width: 300px;
                label: "In 1–2";
                linked: 2;
                expanded: true;
                channels: [{ label: "In 1", level: -18, linked: true }, { label: "In 2", level: -22, linked: true }];
            }
        }
        Row {
            name: "Popovers";
            picker := JPicker {
                title: "Add input";
                placeholder: "Search apps and devices";
                items: [
                    { group: "Apps", text: "Spotify", detail: "playing", added: true },
                    { group: "", text: "Firefox", detail: "", added: false },
                    { group: "Devices", text: "USB Microphone", detail: "2 ch", added: false },
                ];
                picked(i) => { root.last-event = "picked " + i; }
                closed => { root.last-event = "picker closed"; }
            }
            JMenu {
                title: "New";
                items: [
                    { text: "Junction", detail: "A virtual mic and speaker", shortcut: "Ctrl+Shift+J", enabled: true },
                    { text: "Cable", detail: "One app straight into another", shortcut: "Ctrl+Shift+K", enabled: true },
                    { text: "From template…", detail: "", shortcut: "", enabled: true },
                    { text: "Import preset…", detail: "", shortcut: "", enabled: true },
                ];
                activated(i) => { root.last-event = "menu " + i; }
            }
            JRadioGroup {
                width: 160px;
                label: "Add Bus channels";
                options: ["Stereo pair", "Mono", "Two pairs"];
                changed(i) => { root.last-event = "radio " + i; }
            }
        }
        Row {
            name: "Rename";
            JInlineField {
                width: 420px;
                label: "Junction name";
                original: "Virtual Mic";
                text: "Virtual Mic";
                font-size: Tokens.type-title;
                accepted(t) => { root.last-event = "renamed " + t; }
                cancelled => { root.last-event = "rename cancelled"; }
            }
        }
        Row {
            name: "Confirm";
            JConfirm {
                title: "Delete “Virtual Mic for Zoom”?";
                consequences: ["Its routing stops", "Apps using it fall back to the default mic"];
                confirm-text: "Delete";
                confirmed => { root.last-event = "confirmed"; }
                cancelled => { root.last-event = "cancelled"; }
            }
        }
        Row {
            name: "Tooltip";
            JTooltip { text: "Add input"; shortcut: "Ctrl+N"; }
            JTooltip { text: "Add"; compact: true; }
        }
    }
    VerticalLayout {
        width: 460px;
        spacing: Tokens.space-panel-gap;
        alignment: start;
        Text { text: "Empty state"; color: Tokens.text-strong; }
        JEmptyState {
            height: 150px;
            title: "No inputs yet";
            text: "Add an app, a mic or another Junction.";
            action: "Add input";
            shortcut: "Ctrl+N";
            activated => { root.last-event = "empty action"; }
        }
        Text { text: "Checklist rows"; color: Tokens.text-strong; }
        JCheckRow { name: "PipeWire"; detail: "Audio server · running"; state: "ok"; }
        JCheckRow { name: "WirePlumber"; detail: "Session manager · starting"; state: "waiting"; }
        JCheckRow {
            name: "Sample rate";
            detail: "HDMI Output runs at 44.1 kHz";
            state: "mismatch";
            code: "pw-metadata -n settings 0 clock.allowed-rates \"[ 44100 48000 ]\"";
            copy(c) => { root.last-event = "copy " + c; }
        }
        Text { text: "Banners"; color: Tokens.text-strong; }
        JBanner { kind: "neutral"; text: "JUNC was updated to 0.2.0."; dismissible: true; }
        JBanner { kind: "warning"; text: "USB Microphone is offline; its links wait for it."; action: "Use default"; }
        JBanner { kind: "error"; text: "The config file has an error at line 12."; action: "Open file"; secondary: "Details"; }
        Text { text: "Toast"; color: Tokens.text-strong; }
        JToast { text: "Default input restored."; action: "Undo"; activated => { root.last-event = "undo"; } }
        Text { text: "Language"; color: Tokens.text-strong; }
        JLanguageRow { current: "Deutsch"; }
    }
    }
}
