// SPDX-License-Identifier: GPL-3.0-or-later
// What Rust gives the window and what the window asks Rust to do (ui.rs,
// app.rs). One global keeps the plumbing in one place.

import { CardItem, PortItem, LinkItem, ChannelItem } from "screens/main.slint";
import { PickerItem } from "components/picker.slint";
import { ImportItem } from "components/import.slint";

// One row of the onboarding system check (checks.rs).
export struct CheckItem {
    // doctor's id: "pipewire", "wireplumber", "pipewire-pulse", "jack".
    id: string,
    // "ok", "mismatch", "missing", "down".
    state: string,
    fix: string,
}

// Words Rust needs in the UI language (it has no translations of its own).
export global Words {
    public pure function new-junction() -> string { @tr("New Junction") }
    public pure function new-cable() -> string { @tr("New Cable") }
    // TRANSLATORS: the tray's menu (design board 19).
    public pure function capturing(apps: string) -> string { @tr("Capturing: {0}", apps) }
    public pure function open-junc() -> string { @tr("Open JUNC") }
    public pure function quit() -> string { @tr("Quit") }
    // TRANSLATORS: the Add Input picker's offers (design boards 35, 40).
    public pure function of-channels(now: int, all: int) -> string { @tr("{0} of {1} channels", now, all) }
    public pure function more-in-pro-audio() -> string { @tr("more in Pro Audio") }
    public pure function pro-audio-note() -> string { @tr("Switches the device to the Pro Audio profile") }
    public pure function use-all-channels() -> string { @tr("Use all channels") }
    public pure function bluetooth-playback() -> string { @tr("A2DP · hi-fi playback") }
    public pure function bluetooth-note() -> string { @tr("Its mic switches the headset to the call profile (HFP): playback drops to call quality.") }
    public pure function add-anyway() -> string { @tr("Add anyway") }
    public pure function choose-another-mic() -> string { @tr("Choose another mic") }
    // TRANSLATORS: board 43's toast; {0} is the new version.
    public pure function updated(version: string) -> string { @tr("JUNC updated to {0} · audio kept running", version) }
    // TRANSLATORS: board 47's banner: the file, the line, juncd's message.
    public pure function config-error-at(file: string, line: int, message: string) -> string {
        @tr("Config error in {0} line {1}: {2}. Using last good config.", file, line, message)
    }
    public pure function config-error(message: string) -> string {
        @tr("Config error: {0}. Using last good config.", message)
    }
    // TRANSLATORS: board 38's toast; {0} is the device now the default.
    public pure function default-input-restored(device: string) -> string { @tr("Default input restored to {0}", device) }
    public pure function default-output-restored(device: string) -> string { @tr("Default output restored to {0}", device) }
    // TRANSLATORS: board 39's banner: an Input channel or a Bus channel,
    // then the other end ("USB Microphone 2 (R)", "Ch 2").
    public pure function link-removed(from: string, to: string) -> string { @tr("Another app removed the link {0} → {1}", from, to) }
    public pure function input-channel(card: string, ch: int, pos: string) -> string {
        pos == "" ? @tr("{0} {1}", card, ch) : @tr("{0} {1} ({2})", card, ch, pos)
    }
    // TRANSLATORS: the language picker's groups (design board 31).
    public pure function current-language() -> string { @tr("Current") }
    public pure function all-languages() -> string { @tr("All languages") }
    // TRANSLATORS: beside the language in use in the language picker.
    public pure function current-word() -> string { @tr("current") }
    // TRANSLATORS: picker group captions (design board 7).
    public pure function running-apps() -> string { @tr("Running apps") }
    public pure function hardware-inputs() -> string { @tr("Hardware inputs") }
    public pure function system-audio() -> string { @tr("System audio") }
    public pure function junctions() -> string { @tr("Junctions") }
    // TRANSLATORS: system audio in the picker: what an output plays.
    public pure function monitor-of(output: string) -> string { @tr("Monitor of {0}", output) }
    public pure function cable() -> string { @tr("Cable") }
    // TRANSLATORS: Add Listen output picker (design board 17).
    public pure function output-devices() -> string { @tr("Output devices") }
    public pure function default-output() -> string { @tr("Default output (follows system)") }
    // TRANSLATORS: Input Options, what a channel feeds: nothing, or a Bus channel.
    public pure function no-bus() -> string { @tr("None") }
    public pure function bus-channel(n: int) -> string { @tr("Ch {0}", n) }
    // TRANSLATORS: the name of a duplicated Junction (design board 21).
    public pure function copy-of(name: string) -> string { @tr("{0} copy", name) }
    // TRANSLATORS: what deleting a Junction removes (design board 22).
    public pure function bus-pair(first: int) -> string { @tr("Ch {0}–{1}", first, first + 1) }
    // TRANSLATORS: joins two items of a list (the last two take list-and).
    public pure function list-comma(a: string, b: string) -> string { @tr("{0}, {1}", a, b) }
    // TRANSLATORS: joins the last two items of a list.
    public pure function list-and(a: string, b: string) -> string { @tr("{0} and {1}", a, b) }
    public pure function inputs-links(inputs: int, links: int) -> string {
        @tr("{n} Input" | "{n} Inputs" % inputs) + " · " + @tr("{n} Link" | "{n} Links" % links)
    }
    public pure function bus-listens(bus: string, listens: int) -> string {
        @tr("Bus {0}", bus) + " · " + @tr("{n} Listen output" | "{n} Listen outputs" % listens)
    }
    // TRANSLATORS: {0} is a list of names, {n} how many.
    public pure function keep-playing(names: string, n: int) -> string {
        @tr("{0} keeps playing as before." | "{0} keep playing as before." % n, names)
    }
}

export struct JunctionItem {
    id: string,
    name: string,
    enabled: bool,
    // "active", "waiting", "off", "unknown"
    status: string,
    // PipeWire node.name of its source.
    node: string,
    cable: bool,
    // Glyphs of its Inputs' kinds and their names, for the second line.
    icons: string,
    inputs: string,
    // Inputs waiting for their device.
    offline: int,
    // App Inputs waiting for their app (board 23).
    waiting: int,
    // A new Cable not set up yet (board 27), held by the window.
    draft: bool,
    // "input", "output" or "none": the system default it is (board 37).
    default-role: string,
    volume: int,
    selected: bool,
    // Index into the level models; -1 for none.
    meter: int,
}

export global View {
    // Sidebar.
    in-out property <[JunctionItem]> junctions;
    // "connected", "starting", "waiting_for_pipewire", or "down" when juncd
    // is not reachable.
    in-out property <string> daemon-state: "down";
    // Main screen of the selected Junction ("" when none).
    in-out property <string> selected;
    in-out property <string> title;
    // The selected Junction is on (board 18 when not).
    in-out property <bool> junction-on: true;
    in-out property <string> node;
    in-out property <int> bus-channels;
    // The selected Junction is a Cable (board 12): its apps, whether they
    // run, its options.
    in-out property <bool> cable;
    in-out property <string> cable-from;
    in-out property <bool> cable-from-running;
    in-out property <string> cable-to;
    in-out property <bool> cable-to-running;
    in-out property <int> cable-volume;
    in-out property <bool> cable-exclusive;
    in-out property <bool> cable-listen;
    in-out property <int> cable-listen-index;
    in-out property <[string]> cable-outputs;
    in-out property <int> apps;
    in-out property <int> devices;
    in-out property <int> off;
    in-out property <int> offline;
    in-out property <int> waiting;
    in-out property <int> listen-count;
    in-out property <bool> stacked;
    in-out property <[CardItem]> cards;
    in-out property <[PortItem]> ports;
    in-out property <[LinkItem]> links;
    in-out property <length> canvas-height;
    in-out property <length> col-x0;
    in-out property <length> col-x1;
    in-out property <length> col-x2;
    in-out property <length> col-w;
    in-out property <length> listen-heading-y;
    in-out property <bool> tip-visible;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    // The link under the pointer: the card at its far end, that card's
    // channel and the Bus channel; tip-listen when it feeds a Listen card.
    in-out property <string> tip-owner;
    in-out property <int> tip-ch;
    in-out property <string> tip-pos;
    in-out property <int> tip-bus;
    in-out property <bool> tip-listen;
    in-out property <bool> show-listen: true;
    // A link being made (boards 13, 14): 0 none, 1 by the pointer, 2 by
    // the keys; its line from the port to the target or the pointer.
    in-out property <int> linking;
    // The card (index into `cards`) the arrow keys move the focus to.
    in-out property <int> focus-card: -1;
    in-out property <LinkItem> pending;
    // Onboarding (boards 8, 9): 0 none, 1 the system check, 2 templates.
    in-out property <int> onboarding;
    in-out property <[CheckItem]> checks;
    // Board 25: Settings in the main area; Start at login as systemd
    // says (unknown until it answers); the theme followed; the version.
    in-out property <bool> settings-open;
    in-out property <bool> service-known;
    in-out property <bool> start-at-login;
    in-out property <bool> follow-theme: true;
    // Board 31: the language follows Omarchy, or the one picked; its own
    // name; the picker.
    in-out property <bool> follow-language: true;
    in-out property <string> language-name: "English";
    in-out property <bool> lang-open;
    in-out property <[PickerItem]> lang-items;
    in-out property <string> lang-search;
    in-out property <int> lang-cursor;
    in-out property <int> lang-count;
    in-out property <string> version;
    // Board 24: Import existing setups, what juncd found, how many are
    // checked.
    in-out property <bool> import-open;
    in-out property <bool> import-scanning;
    in-out property <[ImportItem]> import-items;
    in-out property <int> import-count;
    // Board 20: the audio server's rows of the same check.
    in-out property <[CheckItem]> service-checks;
    // Doctor is running.
    in-out property <bool> checking;
    in-out property <bool> checks-passed;
    // The Add Input picker (board 7).
    in-out property <bool> empty-inputs;
    in-out property <bool> empty-listens;
    in-out property <length> empty-listens-y;
    in-out property <length> empty-h;
    in-out property <bool> picker-open;
    // The picker adds Listen outputs (board 17) rather than Inputs.
    in-out property <bool> picker-listen;
    // It picks a Cable's app: 1 the one it takes from, 2 the one it feeds.
    in-out property <int> picker-cable;
    // Board 27: the selected Cable is a draft the window holds.
    in-out property <bool> cable-draft;
    // The Add Bus channels popover (board 16).
    in-out property <bool> adding-bus;
    // The name field in the header (board 26: F2 or the pencil).
    in-out property <bool> renaming;
    // Board 37: the selected Junction's default role, its menu open.
    in-out property <string> default-role: "none";
    in-out property <bool> defaults-open;
    // Board 39: a link another tool removed, for the selected Junction.
    in-out property <string> overridden;
    // Board 47: the config file's error, the banner's text.
    in-out property <string> config-error;
    // Board 38: the toast, and whether it can undo.
    in-out property <string> toast;
    in-out property <bool> toast-undo;
    // Board 43: the release notes the toast's What's new opens.
    in-out property <string> toast-news;
    // Deleting the selected Junction (board 22): what goes with it, and
    // what stays as it was.
    in-out property <bool> confirming;
    // Board 21: the context menu of this sidebar row (-1: closed), its
    // cursor; the selected row, for the Menu key.
    in-out property <int> menu-index: -1;
    in-out property <int> menu-cursor;
    in-out property <int> selected-row;
    in-out property <[string]> delete-lines;
    in-out property <string> delete-note;
    // Input Options (boards 15, 30): card `options-index`, at its card's
    // rectangle on the canvas.
    in-out property <bool> options-open;
    in-out property <int> options-index;
    in-out property <length> options-x;
    in-out property <length> options-y;
    in-out property <length> options-w;
    in-out property <length> options-h;
    in-out property <string> options-title;
    in-out property <bool> options-app;
    in-out property <bool> options-exclusive;
    in-out property <[ChannelItem]> options-channels;
    in-out property <[int]> options-feeds;
    in-out property <[string]> bus-options;
    in-out property <[PickerItem]> picker-items;
    in-out property <string> picker-search;
    in-out property <int> picker-cursor;
    // Meters, by index.
    in-out property <[float]> levels;
    in-out property <[float]> peaks;

    callback select(string);
    callback junction-toggled(string, bool);
    callback junction-volume(string, int);
    // The canvas got a new width: lay it out again.
    callback relayout(length);
    callback card-toggled(int, int, bool);
    callback card-volume(int, int, int);
    callback pointer-moved(length, length);
    callback pointer-left();
    callback link-clicked();
    callback port-remove(int, int, int, int);
    // A port (column, card, channel, side): pressed to drag a link from
    // it, or Enter on it.
    callback link-start(int, int, int, int);
    callback link-key(int, int, int, int);
    // The pointer while dragging, on the canvas.
    callback link-drag(length, length);
    callback link-drop();
    // ↑ ↓ through the targets.
    callback link-step(int);
    callback link-cancel();
    callback card-arrow(int, int, int);
    // Board 36: open or close a group of an Input card's channels.
    callback group-toggled(int, int);
    callback delete-junction();
    // Board 39: put the link back, or leave it removed.
    callback restore-link();
    callback leave-link();
    // Board 47.
    callback open-config();
    callback dismiss-config-error();
    // Board 43.
    callback open-news();
    // Board 38.
    callback undo-default();
    callback toast-dismissed();
    // Board 37: make the selected Junction the default `role`, or none.
    callback set-default(string);
    // Board 21: a copy of Junction `id` after it.
    callback duplicate(string);
    // Board 26: a new name for the selected Junction.
    callback rename(string);
    callback recheck();
    // Board 20: juncd's journal in a terminal.
    callback open-logs();
    // Board 24.
    callback open-import();
    callback import-toggled(int);
    callback import-cable(int, bool);
    callback import-run();
    // Board 25.
    callback open-settings();
    callback start-at-login-changed(bool);
    callback follow-theme-changed(bool);
    // Board 31.
    callback follow-language-changed(bool);
    callback open-language-picker();
    callback language-search-edited(string);
    callback language-picked(int);
    callback open-source();
    callback copy(string);
    // Step 1 → 2, and back.
    callback onboarding-continue();
    callback onboarding-back();
    // A starting point by template id (templates/<id>.toml).
    callback template-chosen(string);
    // Board 10: New Junction.
    callback new-junction();
    // Board 27: New Cable (Ctrl+Shift+K).
    callback new-cable();
    callback open-picker();
    callback open-listen-picker();
    // Change app… on a Cable: false the app it takes from, true the one it
    // feeds.
    callback open-cable-picker(bool);
    callback cable-exclusive-changed(bool);
    // On or off, and the output its select shows.
    callback cable-listen-toggled(bool, int);
    callback cable-listen-target(int);
    // Add this many Bus channels.
    callback add-bus(int);
    callback options-toggled(int);
    callback options-closed();
    callback options-exclusive-changed(bool);
    // Channel, Bus channel (0: none).
    callback options-feed(int, int);
    callback options-remove();
    callback picker-search-edited(string);
    callback picker-picked(int);
    // Boards 35, 40: the row's alternative (Shift+Enter).
    callback picker-picked-alt(int);
    callback picker-closed();
}
