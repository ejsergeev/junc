// SPDX-License-Identifier: GPL-3.0-or-later
// The Main screen (design boards 1–6): the selected Junction's header,
// the routing canvas (Inputs → Bus → Listen) and the bottom bar. Card,
// port and link positions come from Rust (layout.rs, architecture §7.3);
// this file only draws them and words counts and channel labels in the
// UI language.

import { Tokens } from "../tokens.slint";
import { JCard } from "../components/card.slint";
import { JPort } from "../components/port.slint";
import { JLink } from "../components/link.slint";
import { JMeter } from "../components/meter.slint";
import { JButton, JIconButton } from "../components/button.slint";
import { JTooltip } from "../components/tooltip.slint";
import { JKbd } from "../components/kbd.slint";
import { JConfirm } from "../components/confirm.slint";
import { JInlineField } from "../components/inline-field.slint";
import { JEmptyState } from "../components/empty-state.slint";
import { JPicker, PickerItem } from "../components/picker.slint";
import { JBanner } from "../components/banner.slint";
import { JBadge } from "../components/badge.slint";
import { JRadioGroup } from "../components/radio-group.slint";
import { JSelect } from "../components/select.slint";
import { JSwitch } from "../components/switch.slint";

export struct ChannelItem {
    number: int,
    // "L", "R" or "".
    position: string,
    // Index into the level and peak models; -1 for none.
    meter: int,
    // Stacked Listen rows: the Bus channel that feeds them (0: none).
    source: int,
}

// A row of a grouped card (board 36): a group of channels, or one of an
// open group's channels.
export struct CardRow {
    group: bool,
    // The group's channels, or the channel (`first`).
    first: int,
    last: int,
    expanded: bool,
    linked: int,
    // Index into the levels: the channel's, or the group's channels'.
    meter: int,
    meters: [int],
}

export struct CardItem {
    // 0 Inputs, 1 Bus, 2 Listen.
    column: int,
    index: int,
    id: string,
    title: string,
    // A Nerd Font glyph.
    icon: string,
    on: bool,
    // "ok", "offline", "not-running"
    state: string,
    exclusive: bool,
    volume: int,
    // Bus: the group's first channel and whether it is a pair.
    first: int,
    stereo: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    channels: [ChannelItem],
    // Grouped (board 36): its rows, channels, linked channels, Pro Audio.
    rows: [CardRow],
    total: int,
    linked: int,
    pro-audio: bool,
}

export struct PortItem {
    x: length,
    y: length,
    // "free", "linked", "offline"
    state: string,
    column: int,
    card: int,
    ch: int,
    // 0: the port takes audio in (left edge), 1: gives it out (right edge).
    side: int,
    // The card's title (Inputs, Listen).
    owner: string,
}

export struct LinkItem {
    x: length,
    y: length,
    w: length,
    h: length,
    x1: length,
    y1: length,
    x2: length,
    y2: length,
    offline: bool,
    hovered: bool,
}

// "1 (L)", "Ch 3 (R)", "2".
component ChannelLabel inherits Text {
    in property <int> number;
    in property <string> position;
    in property <bool> bus;
    text: root.bus
        ? (root.position == "" ? @tr("Ch {0}", root.number) : @tr("Ch {0} ({1})", root.number, root.position))
        : (root.position == "" ? root.number : @tr("{0} ({1})", root.number, root.position));
    color: Tokens.text-subtle;
    font-size: Tokens.type-body-small;
    vertical-alignment: center;
}

export component ChannelRow inherits Rectangle {
    in property <ChannelItem> ch;
    in property <bool> bus;
    in property <bool> stacked-listen;
    in property <bool> live: true;
    in property <[float]> levels;
    in property <[float]> peaks;
    height: 28px * Tokens.scale;
    HorizontalLayout {
        spacing: Tokens.space-row-gap;
        if !root.stacked-listen: ChannelLabel {
            // Bus labels grow with the language ("Kanal 1 (L)").
            width: max(root.bus ? 64px * Tokens.scale : 40px * Tokens.scale, self.preferred-width);
            number: root.ch.number;
            position: root.ch.position;
            bus: root.bus;
        }
        if root.stacked-listen: Text {
            width: max(64px * Tokens.scale, self.preferred-width);
            text: @tr("{0} ← Ch {1}", root.ch.position != "" ? root.ch.position : root.ch.number, root.ch.source);
            color: Tokens.text-subtle;
            font-size: Tokens.type-body-small;
            vertical-alignment: center;
        }
        Rectangle {
            JMeter {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                level: root.live && root.ch.meter >= 0 ? root.levels[root.ch.meter] : -60;
                peak: root.live && root.ch.meter >= 0 ? root.peaks[root.ch.meter] : -60;
            }
        }
    }
}

component ColumnHeading inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <string> add-tip;
    in property <string> add-key;
    callback add();
    height: 44px * Tokens.scale;
    VerticalLayout {
        x: 0;
        width: root.width - 36px * Tokens.scale;
        spacing: 2px;
        Text {
            text: root.title;
            color: Tokens.text-strong;
            font-size: Tokens.type-heading;
            accessible-role: none;
        }
        Text {
            text: root.count;
            color: Tokens.text-subtle;
            font-size: Tokens.type-caption;
            overflow: elide;
            accessible-role: none;
        }
    }
    JIconButton {
        x: root.width - self.width;
        y: 2px;
        icon: "\u{f0415}";
        tooltip: root.add-tip;
        shortcut: root.add-key;
        clicked => { root.add(); }
    }
}

// Add Bus channels (board 16): a stereo pair or one mono channel after the
// last; ↑ ↓ choose, Enter adds, Esc cancels.
component AddBus inherits Rectangle {
    in property <int> channels;
    callback add(int);
    callback closed();
    property <int> count: choice.selected == 0 ? 2 : 1;
    property <bool> room: root.channels + root.count <= 64;
    // Wider when the language needs it for its buttons.
    width: max(280px * Tokens.scale, lay.min-width);
    background: Tokens.surface-window;
    border-width: Tokens.border-popover;
    border-color: Tokens.accent;
    accessible-role: groupbox;
    accessible-label: @tr("Add Bus channels");

    public function open() { choice.focus(); }
    function run() {
        if root.room { root.add(root.count); }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == "\n" { root.run(); return accept; }
            if e.text == Key.Escape { root.closed(); return accept; }
            reject
        }
        lay := VerticalLayout {
            padding: Tokens.space-popup-pad;
            spacing: Tokens.space-row-gap;
            Text {
                text: @tr("Add Bus channels");
                color: Tokens.text-strong;
                font-size: Tokens.type-title;
                accessible-role: none;
            }
            choice := JRadioGroup {
                label: @tr("Add Bus channels");
                options: [@tr("Stereo pair"), @tr("Mono")];
                details: [
                    @tr("Ch {0}–{1}", root.channels + 1, root.channels + 2),
                    @tr("Ch {0}", root.channels + 1),
                ];
            }
            Text {
                text: root.room
                    ? @tr("Apps that pick this Junction see {0} channels.", root.channels + root.count)
                    : @tr("A Bus has at most 64 channels.");
                color: Tokens.text-subtle;
                font-size: Tokens.type-body-small;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-row-gap;
                JButton {
                    text: @tr("Cancel");
                    shortcut: "Esc";
                    show-key: true;
                    clicked => { root.closed(); }
                }
                JButton {
                    text: @tr("Add");
                    shortcut: "Enter";
                    show-key: true;
                    primary: true;
                    enabled: root.room;
                    clicked => { root.run(); }
                }
            }
        }
    }
}

// Input Options (boards 15, 30): Exclusive for apps, which Bus channel
// each channel feeds, Remove input (Del). Esc closes.
component InputOptions inherits Rectangle {
    in property <string> title;
    in property <bool> app;
    in property <bool> exclusive;
    in property <[ChannelItem]> channels;
    // Per channel: index into bus-options (0: none).
    in property <[int]> feeds;
    in property <[string]> bus-options;
    callback exclusive-changed(bool);
    callback feed(int, int);
    callback remove();
    callback closed();
    background: Tokens.surface-window;
    border-width: Tokens.border-popover;
    border-color: Tokens.accent;
    accessible-role: groupbox;
    accessible-label: @tr("{0} options", root.title);

    public function open() { keys.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.closed(); return accept; }
            if e.text == Key.Delete { root.remove(); return accept; }
            reject
        }
        VerticalLayout {
            padding: Tokens.space-popup-pad;
            spacing: Tokens.space-row-gap;
            Text {
                text: @tr("{0} options", root.title);
                color: Tokens.text-strong;
                font-size: Tokens.type-title;
                overflow: elide;
                accessible-role: none;
            }
            if root.app: HorizontalLayout {
                spacing: Tokens.space-row-gap;
                JSwitch {
                    y: 0;
                    label: @tr("Exclusive");
                    checked: root.exclusive;
                    toggled(v) => { root.exclusive-changed(v); }
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: @tr("Exclusive");
                        color: Tokens.text-strong;
                        accessible-role: none;
                    }
                    Text {
                        text: @tr("Mute {0} in your speakers while JUNC captures it.", root.title);
                        color: Tokens.text-subtle;
                        font-size: Tokens.type-body-small;
                        wrap: word-wrap;
                    }
                }
            }
            Text {
                // TRANSLATORS: a caption, in capitals where the script has them.
                text: @tr("FEEDS BUS");
                color: Tokens.text-subtle;
                font-size: Tokens.type-caption;
            }
            for ch[i] in root.channels: HorizontalLayout {
                spacing: Tokens.space-row-gap;
                ChannelLabel {
                    width: max(40px * Tokens.scale, self.preferred-width);
                    height: Tokens.size-control;
                    number: ch.number;
                    position: ch.position;
                    accessible-role: none;
                }
                Text {
                    text: "\u{f0054}";
                    height: Tokens.size-control;
                    color: Tokens.text-subtle;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                JSelect {
                    horizontal-stretch: 1;
                    label: @tr("Channel {0} feeds", ch.number);
                    options: root.bus-options;
                    selected: i < root.feeds.length ? root.feeds[i] : 0;
                    changed(v) => { root.feed(ch.number, v); }
                }
            }
            Rectangle {
                height: Tokens.border;
                background: Tokens.line-divider;
            }
            JButton {
                text: @tr("Remove input");
                icon: "\u{f0a7a}";
                shortcut: "Del";
                show-key: true;
                destructive: true;
                clicked => { root.remove(); }
            }
        }
    }
}

// Board 37: the default role of a Junction, two check rows and what they
// mean. Space or Enter checks the row under the cursor (one role at a
// time: checking the other moves it), Esc closes.
component DefaultMenu inherits Rectangle {
    in property <string> role;
    in-out property <int> cursor;
    callback chosen(string);
    callback closed();
    width: 320px * Tokens.scale;
    background: Tokens.surface-window;
    border-width: Tokens.border-popover;
    border-color: Tokens.accent;
    accessible-role: groupbox;
    accessible-label: @tr("Default device");
    public function open() { keys.focus(); }
    function toggle(i: int) {
        if i == 0 { root.chosen(root.role == "input" ? "none" : "input"); }
        if i == 1 { root.chosen(root.role == "output" ? "none" : "output"); }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.DownArrow { root.cursor = 1; return accept; }
            if e.text == Key.UpArrow { root.cursor = 0; return accept; }
            if e.text == " " || e.text == "\n" { root.toggle(root.cursor); return accept; }
            if e.text == Key.Escape { root.closed(); return accept; }
            reject
        }
    }
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        for row[i] in [
            { text: @tr("Use as default input"), on: root.role == "input" },
            { text: @tr("Use as default output"), on: root.role == "output" },
        ]: line := Rectangle {
            height: Tokens.size-control;
            property <bool> current: i == root.cursor;
            background: self.current ? Tokens.control-hover-fill : transparent;
            border-width: self.current ? Tokens.border : 0;
            border-color: Tokens.control-hover-border;
            accessible-role: checkbox;
            accessible-label: row.text;
            accessible-checkable: true;
            accessible-checked: row.on;
            accessible-action-default => { root.toggle(i); }
            TouchArea {
                clicked => { root.cursor = i; root.toggle(i); }
                moved => { root.cursor = i; }
            }
            HorizontalLayout {
                padding-left: Tokens.space-row-pad-x;
                spacing: 10px;
                Rectangle {
                    width: 14px * Tokens.scale;
                    height: 14px * Tokens.scale;
                    y: (parent.height - self.height) / 2;
                    border-width: Tokens.border;
                    border-color: row.on ? Tokens.accent : Tokens.line-divider;
                    background: row.on ? Tokens.accent.with-alpha(0.25) : transparent;
                    if row.on: Text {
                        text: "\u{f012c}";
                        color: Tokens.accent;
                        font-size: Tokens.type-caption;
                        accessible-role: none;
                    }
                }
                Text {
                    text: row.text;
                    color: line.current ? Tokens.accent : Tokens.text-strong;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        Text {
            text: @tr("Apps that follow the system default use this Junction. Turning it off or deleting it restores the previous default.");
            color: Tokens.text-subtle;
            font-size: Tokens.type-body-small;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

export component MainScreen inherits Rectangle {
    // The Junction.
    in property <string> title;
    in property <string> node;
    in property <int> bus-channels;
    in property <bool> cable;
    // Off (board 18): a banner, every card dimmed, nothing linked.
    in property <bool> on: true;
    // Input counts.
    in property <int> apps;
    in property <int> devices;
    in property <int> off;
    in property <int> offline;
    in property <int> waiting;
    in property <int> listen-count;
    // From layout.rs.
    in property <bool> stacked;
    in property <[CardItem]> cards;
    in property <[PortItem]> ports;
    in property <[LinkItem]> links;
    in property <length> canvas-height;
    in property <length> col-x0;
    in property <length> col-x1;
    in property <length> col-x2;
    in property <length> col-w;
    in property <length> listen-heading-y;
    // Meters, by index (ChannelItem.meter).
    in property <[float]> levels;
    in property <[float]> peaks;
    // The link under the pointer.
    in property <bool> tip-visible;
    in property <length> tip-x;
    in property <length> tip-y;
    in property <string> tip-owner;
    in property <int> tip-ch;
    in property <string> tip-pos;
    in property <int> tip-bus;
    in property <bool> tip-listen;
    // A link being made: 0 none, 1 by the pointer, 2 by the keys.
    in property <int> linking;
    // The card (index into `cards`) to take the focus; -1 none.
    in property <int> focus-card: -1;
    in property <LinkItem> pending;
    // Show the Listen column (bottom bar).
    in-out property <bool> show-listen: true;
    // A tile narrower than 1100 px (the window says so, not this screen's
    // own width, which comes from its content).
    in property <bool> narrow;
    // What layout.rs lays out: the canvas less its side padding.
    out property <length> canvas-width: canvas.width - 2 * root.pad;
    in-out property <bool> confirming;
    // Empty columns (board 11): their boxes' tops and height.
    in property <bool> empty-inputs;
    in property <bool> empty-listens;
    in property <length> empty-listens-y;
    in property <length> empty-h;
    // The Add Input picker (board 7).
    in property <bool> picker-open;
    // It adds Listen outputs (board 17).
    in property <bool> picker-listen;
    in property <[PickerItem]> picker-items;
    in-out property <string> picker-search;
    in-out property <int> picker-cursor;
    // The Add Bus channels popover (board 16).
    in-out property <bool> adding-bus;
    // Input Options (boards 15, 30) of Input card `options-index`, which
    // sits at options-x/y/w/h on the canvas.
    in property <bool> options-open;
    in property <int> options-index;
    in property <length> options-x;
    in property <length> options-y;
    in property <length> options-w;
    in property <length> options-h;
    in property <string> options-title;
    in property <bool> options-app;
    in property <bool> options-exclusive;
    in property <[ChannelItem]> options-channels;
    in property <[int]> options-feeds;
    in property <[string]> bus-options;

    callback card-toggled(int, int, bool);
    callback card-volume(int, int, int);
    callback pointer-moved(length, length);
    callback pointer-left();
    callback link-clicked();
    callback port-remove(int, int, int, int);
    callback link-start(int, int, int, int);
    // Arrow keys on card `i` of `cards`; Rust answers with focus-card.
    callback card-arrow(int, int, int);
    callback focus-card-done();
    // Board 36: open or close the group starting at a channel of Input card.
    callback group-toggled(int, int);
    callback link-key(int, int, int, int);
    callback link-drag(length, length);
    callback link-drop();
    callback link-step(int);
    callback link-cancel();
    callback delete-junction();
    // Board 26: the header's name field is open.
    in-out property <bool> renaming;
    // Board 37: its default role, the menu open, where it opens.
    in property <string> default-role: "none";
    in-out property <bool> defaults-open;
    // Where the Default button sits: after the title and the pencil.
    property <length> defaults-x: root.pad + title-width.preferred-width + 2 * Tokens.space-row-gap + Tokens.size-control;
    title-width := Text {
        visible: false;
        text: root.title;
        font-size: Tokens.type-display;
        accessible-role: none;
    }
    callback set-default(string);
    callback defaults-closed();
    // Board 39: a link another tool removed (its text), the answers.
    in property <string> overridden;
    callback restore-link();
    callback leave-link();
    // A banner under the header: off (board 18) or a removed link.
    property <bool> banner: !root.on || root.overridden != "";
    // Board 22: what deleting it removes, and what stays.
    in property <[string]> delete-lines;
    in property <string> delete-note;
    callback rename(string);
    callback confirm-closed();
    callback turn-on();
    callback open-picker();
    callback open-listen-picker();
    callback add-bus(int);
    callback options-toggled(int);
    callback options-closed();
    callback options-exclusive-changed(bool);
    callback options-feed(int, int);
    callback options-remove();
    callback add-bus-closed();
    callback picker-search-edited(string);
    callback picker-picked(int);
    callback picker-picked-alt(int);
    callback picker-closed();

    background: Tokens.surface-window;
    property <length> pad: Tokens.space-panel-pad;
    // What a column heading says.
    property <string> apps-count: @tr("{n} App" | "{n} Apps" % root.apps);
    property <string> devices-count: @tr("{n} Device" | "{n} Devices" % root.devices);
    property <string> inputs-count: (root.apps > 0 && root.devices > 0
            // TRANSLATORS: two counts in a row, "2 Apps, 1 Device".
            ? @tr("{0}, {1}", root.apps-count, root.devices-count)
            : root.apps > 0 ? root.apps-count
            : root.devices > 0 ? root.devices-count
            : @tr("None yet"))
        + (root.off > 0 ? " · " + @tr("{0} off", root.off) : "")
        + (root.offline > 0 ? " · " + @tr("{0} offline", root.offline) : "")
        + (root.waiting > 0 ? " · " + @tr("{0} waiting", root.waiting) : "");
    property <string> bus-count: @tr("{n} Channel" | "{n} Channels" % root.bus-channels);
    property <string> listen-heading: (root.listen-count == 0 ? @tr("None")
            : @tr("{n} Device" | "{n} Devices" % root.listen-count))
        + (root.stacked ? " · " + @tr("stacked") : "");

    VerticalLayout {
        // Header: name, rename, default role; node and channels.
        Rectangle {
            height: 62px * Tokens.scale;
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 16px * Tokens.scale;
                spacing: Tokens.space-row-gap;
                if !root.renaming: Text {
                    text: root.title;
                    color: Tokens.text-strong;
                    font-size: Tokens.type-display;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                if !root.renaming: JIconButton {
                    y: (parent.height - self.height) / 2;
                    icon: "\u{f03eb}";
                    tooltip: @tr("Rename");
                    shortcut: "F2";
                    clicked => { root.renaming = true; }
                }
                // Board 26: the name in place, Enter saves, Esc cancels.
                if root.renaming: JInlineField {
                    min-width: 360px * Tokens.scale;
                    label: @tr("Name");
                    original: root.title;
                    font-size: Tokens.type-display;
                    init => { self.edit(); }
                    accepted(t) => {
                        root.renaming = false;
                        root.rename(t);
                    }
                    // The same name changes nothing; the window takes the keys back.
                    cancelled => {
                        root.renaming = false;
                        root.rename(root.title);
                    }
                }
                // Board 11 has no Default menu until something feeds it.
                if root.apps + root.devices > 0: JButton {
                    y: (parent.height - self.height) / 2;
                    text: root.default-role == "input" ? @tr("Default input")
                        : root.default-role == "output" ? @tr("Default output") : @tr("Default");
                    icon: "\u{f0140}";
                    controlled: true;
                    checked: root.default-role != "none";
                    clicked => { root.defaults-open = true; }
                }
                Text {
                    text: root.node + " · " + @tr("{0} ch", root.bus-channels);
                    color: Tokens.text-subtle;
                    font-size: Tokens.type-caption;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    min-width: 0;
                    horizontal-stretch: 1;
                }
            }
        }
        // Board 39: another tool removed a link; put it back or leave it.
        if root.on && root.overridden != "": Rectangle {
            height: 50px * Tokens.scale;
            JBanner {
                x: root.pad;
                y: 14px * Tokens.scale;
                width: parent.width - 2 * root.pad;
                kind: "warning";
                text: root.overridden;
                action: @tr("Restore");
                action-key: "Enter";
                secondary: @tr("Leave as is");
                activated => { root.restore-link(); }
                secondary-activated => { root.leave-link(); }
            }
        }
        // Off: what that means and how to undo it.
        if !root.on: Rectangle {
            height: 50px * Tokens.scale;
            JBanner {
                x: root.pad;
                y: 14px * Tokens.scale;
                width: parent.width - 2 * root.pad;
                text: @tr("Junction is off — apps see silence");
                action: @tr("Turn on");
                action-key: "Space";
                action-primary: false;
                activated => { root.turn-on(); }
            }
        }
        // Column headings (Listen's moves into the canvas when stacked).
        Rectangle {
            height: 56px * Tokens.scale;
            ColumnHeading {
                x: root.pad + root.col-x0;
                y: 12px * Tokens.scale;
                width: root.col-w;
                title: @tr("Inputs");
                count: root.inputs-count;
                add-tip: @tr("Add input");
                add-key: "Ctrl+N";
                add => { root.open-picker(); }
            }
            ColumnHeading {
                x: root.pad + root.col-x1;
                y: 12px * Tokens.scale;
                width: root.col-w;
                title: @tr("Bus");
                count: root.bus-count;
                add-tip: @tr("Add Bus channels");
                add-key: "Ctrl+Shift+N";
                add => { root.adding-bus = true; }
            }
            if !root.stacked && root.show-listen: ColumnHeading {
                x: root.pad + root.col-x2;
                y: 12px * Tokens.scale;
                width: root.col-w;
                title: @tr("Listen");
                count: root.listen-heading;
                add-tip: @tr("Add Listen output");
                add-key: "Ctrl+M";
                add => { root.open-listen-picker(); }
            }
        }
        // The routing canvas.
        canvas := Flickable {
            // The wheel scrolls; a drag belongs to the ports (links).
            interactive: false;
            content-height: max(self.height, root.canvas-height + root.pad);
            content-width: self.width;
            hover := TouchArea {
                width: canvas.content-width;
                height: canvas.content-height;
                moved => {
                    root.pointer-moved(self.mouse-x - root.pad, self.mouse-y);
                }
                changed has-hover => {
                    if !self.has-hover { root.pointer-left(); }
                }
                clicked => { root.link-clicked(); }
            }
            for l in root.links: JLink {
                x: root.pad + l.x;
                y: l.y;
                width: l.w;
                height: l.h;
                x1: l.x1;
                y1: l.y1;
                x2: l.x2;
                y2: l.y2;
                offline: l.offline;
                hovered: l.hovered;
            }
            if root.stacked && root.show-listen: ColumnHeading {
                x: root.pad + root.col-x2;
                y: root.listen-heading-y;
                width: root.col-w;
                title: @tr("Listen");
                count: root.listen-heading;
                add-tip: @tr("Add Listen output");
                add-key: "Ctrl+M";
                add => { root.open-listen-picker(); }
            }
            if root.empty-inputs: JEmptyState {
                x: root.pad + root.col-x0;
                y: 0;
                width: root.col-w;
                // Long languages wrap: never cut the button off.
                height: max(root.empty-h, self.preferred-height);
                title: @tr("No inputs yet");
                text: @tr("Pick an app, a mic or system audio.");
                action: @tr("Add input");
                shortcut: "Ctrl+N";
                activated => { root.open-picker(); }
            }
            if root.empty-listens: JEmptyState {
                x: root.pad + root.col-x2;
                y: root.empty-listens-y;
                width: root.col-w;
                // Long languages wrap: never cut the button off.
                height: max(root.empty-h, self.preferred-height);
                title: @tr("Not listening");
                text: @tr("Hear this Junction on an output.");
                action: @tr("Add listen output");
                shortcut: "Ctrl+M";
                activated => { root.open-listen-picker(); }
            }
            for c[i] in root.cards: JCard {
                wants-focus: root.focus-card == i;
                focused => { root.focus-card-done(); }
                arrow(dx, dy) => { root.card-arrow(i, dx, dy); }
                opacity: root.on ? 1 : 0.45;
                x: root.pad + c.x;
                y: c.y;
                width: c.w;
                height: c.h;
                title: c.column == 1
                    ? (c.stereo ? @tr("Ch {0}–{1}", c.first, c.first + 1) : @tr("Ch {0}", c.first))
                    : c.title;
                on: c.on;
                state: c.state;
                exclusive: c.exclusive;
                volume: c.volume;
                footer: c.column != 1;
                switchable: c.column != 1;
                tag: c.column == 1 ? (c.stereo ? @tr("stereo") : @tr("mono")) : "";
                options: c.column == 0;
                options-open: root.options-open && c.column == 0 && c.index == root.options-index;
                options-clicked => { root.options-toggled(c.index); }
                app: c.title;
                toggled(v) => { root.card-toggled(c.column, c.index, v); }
                volume-changed(v) => { root.card-volume(c.column, c.index, v); }
                // Board 36: many channels, in groups of eight.
                if c.rows.length > 0: VerticalLayout {
                    spacing: 0;
                    HorizontalLayout {
                        height: 20px * Tokens.scale;
                        spacing: 6px;
                        if c.pro-audio: JBadge {
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 0;
                            text: @tr("Pro Audio");
                        }
                        Text {
                            text: @tr("{0} ch", c.total) + " · " + @tr("{0} linked", c.linked);
                            color: Tokens.text-subtle;
                            font-size: Tokens.type-body-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    for row in c.rows: Rectangle {
                        height: (row.group ? 24px : 20px) * Tokens.scale;
                        if row.group: TouchArea {
                            clicked => { root.group-toggled(c.index, row.first); }
                        }
                        if row.group: HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 12px * Tokens.scale;
                                text: row.expanded ? "\u{f0140}" : "\u{f0142}";
                                color: Tokens.text-subtle;
                                font-size: Tokens.type-body-small;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                width: 72px * Tokens.scale;
                                text: @tr("In {0}–{1}", row.first, row.last);
                                color: Tokens.text-strong;
                                font-size: Tokens.type-body-small;
                                vertical-alignment: center;
                            }
                            if !row.expanded: HorizontalLayout {
                                spacing: 2px;
                                for m in row.meters: Rectangle {
                                    width: 6px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    background: Tokens.track;
                                    Rectangle {
                                        y: parent.height - self.height;
                                        height: parent.height * clamp((root.levels[m] + 60) / 60, 0, 1);
                                        background: Tokens.meter-safe;
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: row.expanded ? @tr("{0} of {1} linked", row.linked, row.last - row.first + 1)
                                    : @tr("{0} ch", row.last - row.first + 1);
                                color: Tokens.text-subtle;
                                font-size: Tokens.type-body-small;
                                vertical-alignment: center;
                            }
                        }
                        if !row.group: HorizontalLayout {
                            padding-left: 18px * Tokens.scale;
                            spacing: Tokens.space-row-gap;
                            Text {
                                width: 40px * Tokens.scale;
                                text: @tr("In {0}", row.first);
                                color: Tokens.text-subtle;
                                font-size: Tokens.type-body-small;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                JMeter {
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width;
                                    level: root.on && c.on && c.state == "ok" ? root.levels[row.meter] : -60;
                                    peak: root.on && c.on && c.state == "ok" ? root.peaks[row.meter] : -60;
                                }
                            }
                        }
                    }
                }
                if c.rows.length == 0: HorizontalLayout {
                    spacing: 10px * Tokens.scale;
                    if c.column == 0: Rectangle {
                        width: 40px * Tokens.scale;
                        height: 40px * Tokens.scale;
                        y: (parent.height - self.height) / 2;
                        border-width: Tokens.border;
                        border-color: c.state == "offline" ? Tokens.status-urgent : Tokens.line-divider;
                        Text {
                            text: c.icon;
                            font-size: Tokens.type-heading;
                            color: c.state == "offline" ? Tokens.status-urgent : Tokens.text-default;
                            accessible-role: none;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px * Tokens.scale;
                        alignment: start;
                        for ch in c.channels: ChannelRow {
                            ch: ch;
                            bus: c.column == 1;
                            stacked-listen: c.column == 2 && root.stacked;
                            live: root.on && c.on && c.state == "ok";
                            levels: root.levels;
                            peaks: root.peaks;
                        }
                    }
                }
            }
            for p in root.ports: JPort {
                opacity: root.on ? 1 : 0.45;
                x: root.pad + p.x - self.width / 2;
                y: p.y - self.height / 2;
                state: p.state;
                label: p.column == 1
                    ? (p.side == 0 ? @tr("Bus channel {0} in", p.ch) : @tr("Bus channel {0} out", p.ch))
                    : @tr("{0} channel {1}", p.owner, p.ch);
                remove => { root.port-remove(p.column, p.card, p.ch, p.side); }
                linking: root.linking > 0;
                activated => { root.link-key(p.column, p.card, p.ch, p.side); }
                drag-started => { root.link-start(p.column, p.card, p.ch, p.side); }
                dragged(dx, dy) => { root.link-drag(p.x - self.width / 2 + dx, p.y - self.height / 2 + dy); }
                dropped => { root.link-drop(); }
                step(d) => { root.link-step(d); }
                cancel => { root.link-cancel(); }
            }
            // The link being made, over the others.
            if root.linking > 0: JLink {
                x: root.pad + root.pending.x;
                y: root.pending.y;
                width: root.pending.w;
                height: root.pending.h;
                x1: root.pending.x1;
                y1: root.pending.y1;
                x2: root.pending.x2;
                y2: root.pending.y2;
                offline: root.pending.offline;
            }
            // Under its card; beside it on a narrow tile (board 30).
            if root.options-open: InputOptions {
                x: root.pad + root.options-x + (root.narrow ? root.options-w + 8px * Tokens.scale : 0);
                y: root.options-y + (root.narrow ? 56px * Tokens.scale : root.options-h);
                width: root.narrow ? 268px * Tokens.scale : root.options-w;
                height: self.preferred-height;
                title: root.options-title;
                app: root.options-app;
                exclusive: root.options-exclusive;
                channels: root.options-channels;
                feeds: root.options-feeds;
                bus-options: root.bus-options;
                init => { self.open(); }
                exclusive-changed(v) => { root.options-exclusive-changed(v); }
                feed(ch, bus) => { root.options-feed(ch, bus); }
                remove => { root.options-remove(); }
                closed => { root.options-closed(); }
            }
            if root.tip-visible: JTooltip {
                width: self.preferred-width;
                height: self.preferred-height;
                x: root.pad + min(root.tip-x + 12px, canvas.content-width - self.width - root.pad);
                y: root.tip-y + 16px;
                property <string> ch: root.tip-pos == "" ? root.tip-ch : @tr("{0} ({1})", root.tip-ch, root.tip-pos);
                property <string> route: root.tip-listen
                    ? @tr("Ch {0} → {1} {2}", root.tip-bus, root.tip-owner, self.ch)
                    : @tr("{0} {1} → Ch {2}", root.tip-owner, self.ch, root.tip-bus);
                // Hovering a link: what a click does, then the link. Making
                // one: the link, then how to finish (boards 13, 14).
                text: root.linking > 0 ? self.route : @tr("Click to unlink");
                shortcut: root.linking == 1 ? "Esc" : root.linking == 2 ? "Enter" : "Del";
                detail: root.linking == 1 ? @tr("Release to link · Esc cancels")
                    : root.linking == 2 ? @tr("Enter connects · Esc cancels")
                    : self.route;
            }
        }
        // Bottom bar: delete, keyboard hints, Show Listen.
        Rectangle {
            height: 45px * Tokens.scale;
            Rectangle {
                y: 0;
                height: Tokens.border;
                background: Tokens.line-divider;
            }
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: Tokens.space-row-gap;
                alignment: space-between;
                JButton {
                    y: (parent.height - self.height) / 2;
                    text: @tr("Delete");
                    icon: "\u{f0a7a}";
                    shortcut: "Ctrl+Delete";
                    clicked => { root.confirming = true; }
                }
                // The design's Narrow board has no room for the hints.
                if !root.narrow: HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    // While a link is made, only its keys (boards 13, 14).
                    for hint in root.linking == 1 ? [
                        { key: "Esc", text: @tr("cancel link") },
                    ] : root.linking == 2 ? [
                        { key: "↑↓", text: @tr("target") },
                        { key: "Enter", text: @tr("connect") },
                        { key: "Esc", text: @tr("cancel") },
                    ] : [
                        { key: "Tab", text: @tr("move") },
                        { key: "Space", text: @tr("toggle") },
                        { key: "Enter", text: @tr("link") },
                        { key: "Del", text: @tr("unlink") },
                        { key: "F2", text: @tr("rename") },
                    ]: HorizontalLayout {
                        spacing: 4px;
                        padding-right: 10px;
                        JKbd { y: (parent.height - self.height) / 2; text: hint.key; }
                        Text {
                            text: hint.text;
                            color: Tokens.text-subtle;
                            font-size: Tokens.type-body-small;
                            vertical-alignment: center;
                        }
                    }
                }
                // Nothing to show or hide without Listen outputs (board 11).
                if root.listen-count > 0: JButton {
                    y: (parent.height - self.height) / 2;
                    text: @tr("Show Listen");
                    icon: "\u{f06d0}";
                    checkable: true;
                    checked <=> root.show-listen;
                }
            }
        }
    }

    // The Add Input picker over the Inputs column (board 7), the Add
    // Listen output picker over the Listen column's right edge (board 17).
    if root.picker-open: Rectangle {
        TouchArea { clicked => { root.picker-closed(); } }
        picker := JPicker {
            x: root.picker-listen ? root.pad + root.col-x2 + root.col-w - self.width : root.pad + root.col-x0;
            y: (62px + (root.banner ? 50px : 0) + 56px) * Tokens.scale
                + (root.picker-listen && root.stacked ? root.listen-heading-y + 56px * Tokens.scale + canvas.viewport-y : 0);
            height: self.preferred-height;
            title: root.picker-listen ? @tr("Add listen output") : @tr("Add input");
            placeholder: root.picker-listen ? @tr("Search output devices") : @tr("Search apps, inputs, system audio");
            note: root.picker-listen ? @tr("Plug in headphones or a USB device to see it here.") : "";
            search-icon: "\u{f0349}";
            hints: true;
            items: root.picker-items;
            search <=> root.picker-search;
            cursor <=> root.picker-cursor;
            init => { self.open(); }
            search-edited(t) => { root.picker-search-edited(t); }
            picked(i) => { root.picker-picked(i); }
            picked-alt(i) => { root.picker-picked-alt(i); }
            closed => { root.picker-closed(); }
        }
    }

    // Add Bus channels, right-aligned to the Bus column (board 16).
    if root.adding-bus: Rectangle {
        TouchArea {
            clicked => {
                root.adding-bus = false;
                root.add-bus-closed();
            }
        }
        AddBus {
            x: root.pad + root.col-x1 + root.col-w - self.width;
            y: (62px + (root.banner ? 50px : 0) + 56px) * Tokens.scale;
            height: self.preferred-height;
            channels: root.bus-channels;
            init => { self.open(); }
            add(n) => {
                root.adding-bus = false;
                root.add-bus(n);
            }
            closed => {
                root.adding-bus = false;
                root.add-bus-closed();
            }
        }
    }

    // Board 37: the default role, under its button.
    if root.defaults-open: Rectangle {
        TouchArea { clicked => { root.defaults-open = false; root.defaults-closed(); } }
        DefaultMenu {
            x: root.defaults-x;
            y: 52px * Tokens.scale;
            height: self.preferred-height;
            role: root.default-role;
            init => { self.open(); }
            chosen(r) => { root.set-default(r); }
            closed => { root.defaults-open = false; root.defaults-closed(); }
        }
    }

    // Delete confirmation (board 22): what it means for apps, what goes
    // with it, what stays.
    if root.confirming: Rectangle {
        background: Tokens.surface-desktop.with-alpha(0.6);
        TouchArea { }
        dialog := JConfirm {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            height: self.preferred-height;
            show-keys: true;
            title: @tr("Delete “{0}”?", root.title);
            lead: @tr("Apps that record from it hear silence until you pick another input there.");
            // TRANSLATORS: heading of the list of what a deleted Junction takes along.
            heading: @tr("REMOVED WITH IT");
            consequences: root.delete-lines;
            note: root.delete-note;
            confirm-text: @tr("Delete Junction");
            confirm-icon: "\u{f0a7a}";
            init => { self.open(); }
            confirmed => {
                root.confirming = false;
                root.delete-junction();
            }
            cancelled => {
                root.confirming = false;
                root.confirm-closed();
            }
        }
    }
}
