# SPDX-License-Identifier: GPL-3.0-or-later
# JUNC daemon, as a systemd user service (docs/architecture.md §3.14).
# `junc service enable` turns on "Start at login"; D-Bus activation starts
# it on demand otherwise.

[Unit]
Description=JUNC audio routing daemon
Documentation=https://github.com/ejsergeev/junc
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=notify
ExecStart=/usr/bin/juncd
# One malloc arena: juncd's helper threads allocate little, and each extra
# glibc arena can be backed by a whole 2 MB transparent huge page (seen on
# Arch Linux ARM), doubling the daemon's memory for nothing.
Environment=GLIBC_TUNABLES=glibc.malloc.arena_max=1
Restart=on-failure
RestartSec=1
# 2: bad arguments, 3: no usable config, 4: another juncd owns the bus name.
# Restarting would not help.
RestartPreventExitStatus=2 3 4
NoNewPrivileges=yes
Slice=session.slice

[Install]
WantedBy=default.target
